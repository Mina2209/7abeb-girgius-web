# API base URL (no trailing slash, no /api suffix — the client appends /api itself).
# Production: the origin of the EC2 backend, e.g. http://34.231.244.96
VITE_API_BASE_URL=http://localhost:8080

# Optional dedicated media origin for raw S3 keys (a public bucket or CDN).
# LEAVE THIS UNSET for the S3-website + EC2 deployment: raw keys are not routes on
# the API server, so pointing it there yields 404s. Unset means raw keys are served
# through the API's /api/uploads/thumb endpoint, which is what you want.
# VITE_MEDIA_SERVER_URL=

# First-party analytics client gate
VITE_ANALYTICS_ENABLED=false
