# Postgres connection string for Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# JWT Secret for authentication
JWT_SECRET=your-jwt-secret-here

# Optional: server port
PORT=8080

# AWS S3 configuration
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=

# Optional: S3 key prefix (default: Uploads/)
# S3_KEY_PREFIX=
# Optional: S3 folder mapping (JSON string)
# S3_FOLDER_MAP={"hymn":"Hymns","image":"Images","powerpoint":"PowerPoints"}
# Optional: comma-separated allowlist of S3 folder names
# S3_ALLOWED_FOLDERS=

# Optional: JSON body size limit
# JSON_BODY_LIMIT=256mb

# First-party analytics (server-side recording gate)
# ANALYTICS_ENABLED=false

# User activity / audit log recording gate (defaults to enabled)
# USER_ACTIVITY_ENABLED=true

# Backup scheduler (auto-start in production or when set to true)
# ENABLE_BACKUP_SCHEDULER=false
# LOG_RETENTION_DAYS=90

# ZIP download tuning
# MAX_ZIP_CONCURRENCY=
# ZIP_LOAD_THRESHOLD=0.85
# ZIP_MIN_FREE_MEM=0.15

# CORS origin (uncomment for production)
# CORS_ORIGIN_PROD=
