datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Hymn {
  id         String   @id @default(uuid())
  title      String
  tags       Tag[]
  files      File[]
  lyric      Lyric?   // One-to-one optional relation
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Lyric {
  id         String   @id @default(uuid())
  hymn       Hymn     @relation(fields: [hymnId], references: [id], onDelete: Cascade)
  hymnId     String   @unique  // One lyric per hymn
  content    String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Saying {
  id          String   @id @default(uuid())
  author      String
  authorImage String?
  source      String?
  content     String
  tags        Tag[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Father {
  id           String   @id @default(uuid())
  name         String   @unique
  title        String?
  bio          String?
  profileImage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TagSection {
  id        String   @id @default(uuid())
  name      String   @unique
  order     Int      @default(0)
  tags      Tag[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id        String      @id @default(uuid())
  name      String      @unique
  order     Int         @default(0)
  section   TagSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  sectionId String?
  hymns     Hymn[]
  sayings   Saying[]
  images    Image[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([sectionId])
}

model File {
  id           String   @id @default(uuid())
  hymn         Hymn     @relation(fields: [hymnId], references: [id], onDelete: Cascade)
  hymnId       String
  type         FileType
  fileUrl      String
  originalName String?  // Original filename (including Unicode chars like Arabic)
  size         Int?
  duration     Int?
  createdAt    DateTime @default(now())

  @@index([hymnId])
}

enum FileType {
  VIDEO_MONTAGE
  VIDEO_POWERPOINT
  POWERPOINT
  MUSIC_AUDIO
}

model Image {
  id        String       @id @default(uuid())
  title     String
  titleNorm String?      // Normalized (Arabic) copy of title for fast indexed search; kept in sync by the app.
  imageUrl  String
  tags      Tag[]
  author    ImageAuthor? @relation(fields: [authorId], references: [id])
  authorId  String?
  type      ImageType?   @relation(fields: [typeId], references: [id])
  typeId    String?
  ai        Boolean      @default(false)
  published Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([authorId])
  @@index([typeId])
}

model ImageAuthor {
  id           String   @id @default(uuid())
  name         String   @unique
  bio          String?
  role         String?
  profileImage String?
  facebook     String?
  instagram    String?
  website      String?
  email        String?
  joinDate     DateTime @default(now())
  specialty    String[]
  images       Image[]
}

model ImageType {
  id     String  @id @default(uuid())
  name   String  @unique
  images Image[]
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String?  @unique
  password     String
  role         Role     @default(EDITOR)
  full_name    String?
  church_name  String?
  church_role  String?
  services     String[]
  avatar_url   String?
  tokenVersion Int      @default(0) // Bump to invalidate all outstanding JWTs (e.g. on password change)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  logs         Log[]
  favorites    Favorite[]
  activities   UserActivity[]
}

model Log {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Favorite {
  id          String         @id @default(uuid())
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  contentType FavoriteContentType
  contentId   String
  createdAt   DateTime       @default(now())

  @@unique([userId, contentType, contentId])
  @@index([userId])
  @@index([contentType, contentId])
}

enum FavoriteContentType {
  HYMN
  IMAGE
  BOOK
  SAYING
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

model SiteSettings {
  /// Singleton row. We fix id=1 in service logic.
  id                      Int      @id @default(1)
  default_book_cover     String
  site_sections_visibility Json?
  powerpoint_data         Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

/// First-party usage analytics. Anonymous by default: visitorId/sessionId are random
/// non-identifying identifiers generated in the browser. userId is ONLY set for
/// authenticated users and is intentionally nullable. No credentials, tokens, or PII.
model AnalyticsEvent {
  id              String   @id @default(cuid())
  eventName       String
  createdAt       DateTime @default(now())
  route           String?
  visitorId       String?
  sessionId       String?
  contentType     String?
  contentId       String?
  contentName     String?
  deviceCategory  String?
  browserCategory String?
  language        String?
  referrer        String?
  properties      Json?
  userId          String?

  @@index([createdAt])
  @@index([eventName, createdAt])
  @@index([visitorId])
  @@index([sessionId, createdAt])
  @@index([route, createdAt])
  @@index([contentType, contentId])
  @@index([userId])
}

/// Authenticated/anonymous user activity audit trail. The SEPARATE concern from
/// AnalyticsEvent (aggregate stats): this table answers "which authenticated user
/// did what, when, where". Anonymous rows carry only random visitorId/sessionId.
/// userId is ALWAYS derived server-side from the JWT (never trusted from the
/// client). No credentials, tokens, search text, clipboard, or other PII is stored.
/// onDelete: SetNull preserves the audit row if a user account is removed.
model UserActivity {
  id              String   @id @default(cuid())
  action          String
  createdAt       DateTime @default(now())
  route           String?
  visitorId       String?
  sessionId       String?
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  contentType     String?
  contentId       String?
  contentName     String?
  metadata        Json?
  deviceCategory  String?
  browserCategory String?

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([userId, createdAt])
  @@index([visitorId])
  @@index([contentType, contentId])
}
